<UserControl x:Class="LumiSqlFormatter.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:LumiSqlFormatter.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="840"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
             FontFamily="Segoe UI" FontSize="12"
             PreviewMouseDown="OnUserControlPreviewMouseDown">

    <UserControl.DataContext>
        <viewmodels:SettingsViewModel />
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="#007ACC" BorderThickness="3,0,0,0" CornerRadius="0,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lumi SQL Formatter &amp; Snippets" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" TextTrimming="CharacterEllipsis"/>
                    <Border Background="#007ACC" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PHONGNT" FontWeight="Bold" FontSize="10" Foreground="White"/>
                    </Border>
                    <Border Background="#2D7D9A" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.1.5" FontWeight="SemiBold" FontSize="10" Foreground="White"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="T-SQL Formatting &amp; Snippets" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1">
            <!-- TAB 1: CASING & FORMATTING -->
            <TabItem Header="Formatting &amp; Casing">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" MinWidth="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Options Panel -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                    <StackPanel Margin="0,0,4,0">
                        <GroupBox Padding="10" Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="Tùy chọn tự động viết hoa (Auto-Capitalization)" FontWeight="SemiBold" Foreground="#007ACC"/>
                            </GroupBox.Header>
                            <StackPanel>
                                <CheckBox Content="Bật Auto-Capitalization khi gõ phím" 
                                          IsChecked="{Binding EnableAutoCapitalize, Mode=TwoWay}"
                                          FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                    <TextBlock Text="Reserved Keywords:" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <Border Background="#E8F2FA" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="KEYWORD" FontSize="9" FontWeight="Bold" Foreground="#007ACC"/>
                                    </Border>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding CasingStyleOptions}" 
                                          SelectedItem="{Binding KeywordCasing, Mode=TwoWay}"
                                          Margin="0,0,0,8" Height="26"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                    <TextBlock Text="Built-in Data Types:" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <Border Background="#E6F7F5" BorderBrush="#008272" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="DATA TYPE" FontSize="9" FontWeight="Bold" Foreground="#008272"/>
                                    </Border>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding CasingStyleOptions}" 
                                          SelectedItem="{Binding DataTypeCasing, Mode=TwoWay}"
                                          Margin="0,0,0,8" Height="26"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                                    <TextBlock Text="Built-in Functions:" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <Border Background="#F3EFFC" BorderBrush="#6C5CE7" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="FUNCTION" FontSize="9" FontWeight="Bold" Foreground="#6C5CE7"/>
                                    </Border>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding CasingStyleOptions}" 
                                          SelectedItem="{Binding FunctionCasing, Mode=TwoWay}"
                                          Margin="0,0,0,4" Height="26"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Padding="10" Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="Phím tắt thao tác (Hotkeys &amp; Shortcuts)" FontWeight="SemiBold" Foreground="#007ACC"/>
                            </GroupBox.Header>
                            <StackPanel>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="Format Uppercase:" FontWeight="Medium"/>
                                        <TextBlock Text="In hoa từ khóa (như Auto-Cap)" FontSize="10" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding FormatUppercaseShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             PreviewKeyDown="OnShortcutTextBoxPreviewKeyDown"
                                             Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                             FontWeight="SemiBold" ToolTip="Nhấn tổ hợp phím để gán (mặc định: Ctrl+Alt+U)"/>
                                </Grid>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="Format Lowercase:" FontWeight="Medium"/>
                                        <TextBlock Text="Chữ thường (giữ nguyên @biến, #bảng)" FontSize="10" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding FormatLowercaseShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             PreviewKeyDown="OnShortcutTextBoxPreviewKeyDown"
                                             Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                             FontWeight="SemiBold" ToolTip="Nhấn tổ hợp phím để gán (mặc định: Ctrl+Alt+L)"/>
                                </Grid>

                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="Refresh DB Cache:" FontWeight="Medium"/>
                                        <TextBlock Text="Nạp lại danh sách Stored Procedures &amp; Functions" FontSize="10" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding RefreshDbCacheShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             PreviewKeyDown="OnShortcutTextBoxPreviewKeyDown"
                                             Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                             FontWeight="SemiBold" ToolTip="Nhấn tổ hợp phím để gán (mặc định: Ctrl+Shift+R)"/>
                                </Grid>

                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="Tạo nhanh Snippet:" FontWeight="Medium"/>
                                        <TextBlock Text="Mở cửa sổ tạo snippet từ vùng chọn" FontSize="10" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding QuickSnippetShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             PreviewKeyDown="OnShortcutTextBoxPreviewKeyDown"
                                             Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                                             FontWeight="SemiBold" ToolTip="Nhấn tổ hợp phím để gán (mặc định: Ctrl+Alt+S)"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Padding="10" Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="Database Metadata Cache (Thủ tục &amp; Hàm)" FontWeight="SemiBold" Foreground="#8E44AD"/>
                            </GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Tự động nạp danh sách Stored Procedures &amp; Functions từ database active để bảo toàn định dạng gốc:" FontSize="10.5" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Database hiện tại:" FontWeight="Medium" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentDatabaseInfo}" FontWeight="SemiBold" FontSize="11" Foreground="#007ACC" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trạng thái Cache:" FontWeight="Medium" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CacheStatusText}" FontSize="11" Foreground="#107C41" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <Button Content="Làm Mới Cache Database" Command="{Binding RefreshDbCacheCommand}"
                                        Height="24" FontWeight="SemiBold" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                        BorderBrush="#8E44AD" BorderThickness="1" Cursor="Hand"
                                        ToolTip="Kết nối lại và quét ngầm toàn bộ metadata mới nhất của database hiện tại (Mặc định: Ctrl+Shift+R)"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Padding="10" Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="Tùy chọn Snippets &amp; Theme" FontWeight="SemiBold" Foreground="#6C5CE7"/>
                            </GroupBox.Header>
                            <StackPanel>
                                <CheckBox Content="Bật Smart Snippets (Mở rộng khi nhấn Tab)" 
                                          IsChecked="{Binding EnableSnippets, Mode=TwoWay}"
                                          FontWeight="SemiBold" Margin="0,2,0,6"/>

                                <CheckBox Content="Hiển thị gợi ý Snippet khi gõ phím" 
                                          IsChecked="{Binding EnableSnippetSuggestions, Mode=TwoWay}"
                                          Margin="0,2,0,6"/>

                                <Grid Margin="0,4,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Giao diện (Theme):" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,8,0"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SnippetThemeOptions}" SelectedItem="{Binding SnippetTheme, Mode=TwoWay}" 
                                              Height="24" VerticalContentAlignment="Center"/>
                                </Grid>

                                <Border Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderBrush="#B0C4DE" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,2,0,0">
                                    <TextBlock FontSize="11" TextWrapping="Wrap">
                                        <Run Text="Phím tắt: Bôi đen mã T-SQL và nhấn " Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                        <Bold><Run Text="{Binding QuickSnippetShortcut}" Foreground="#007ACC"/></Bold>
                                        <Run Text=" để tạo nhanh snippet" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Padding="10" Margin="0,0,0,10">
                            <GroupBox.Header>
                                <TextBlock Text="Quy tắc và phạm vi loại trừ" FontWeight="SemiBold" Foreground="#107C41"/>
                            </GroupBox.Header>
                            <StackPanel TextBlock.FontSize="11">
                                <WrapPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Kích hoạt:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#EAEAEA" CornerRadius="2" Padding="4,1" Margin="2,1"><TextBlock Text="Space" FontSize="10"/></Border>
                                    <Border Background="#EAEAEA" CornerRadius="2" Padding="4,1" Margin="2,1"><TextBlock Text="Enter" FontSize="10"/></Border>
                                    <Border Background="#EAEAEA" CornerRadius="2" Padding="4,1" Margin="2,1"><TextBlock Text="Tab" FontSize="10"/></Border>
                                    <Border Background="#EAEAEA" CornerRadius="2" Padding="4,1" Margin="2,1"><TextBlock Text="," FontSize="10"/></Border>
                                    <Border Background="#EAEAEA" CornerRadius="2" Padding="4,1" Margin="2,1"><TextBlock Text=";" FontSize="10"/></Border>
                                    <Border Background="#EAEAEA" CornerRadius="2" Padding="4,1" Margin="2,1"><TextBlock Text=")" FontSize="10"/></Border>
                                </WrapPanel>
                                <TextBlock Text="Phạm vi loại trừ an toàn (giữ nguyên gốc):" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <TextBlock Text="• Chuỗi ký tự &amp; Dynamic SQL ('...', N'...')" Foreground="#CE9178" Margin="0,1" TextWrapping="Wrap"/>
                                <TextBlock Text="• Chú thích (-- và /* ... */)" Foreground="#2E7D32" Margin="0,1" TextWrapping="Wrap"/>
                                <TextBlock Text="• Tên trong ngoặc ([...], &quot;...&quot;)" Foreground="#007ACC" Margin="0,1" TextWrapping="Wrap"/>
                                <TextBlock Text="• Biến &amp; Bảng tạm (@Year, #Temp...)" Foreground="#008272" Margin="0,1" TextWrapping="Wrap"/>
                                <TextBlock Text="• Stored Procedures &amp; Functions (sp_..., xp_..., fn_... và hàm khai báo)" Foreground="#7B1FA2" Margin="0,1" TextWrapping="Wrap"/>
                                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,4,0,0">
                                    <TextBlock Text="Bộ phân tích cú pháp: Microsoft ScriptDom T-SQL Lexer" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="10.5" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Lưu Cài Đặt" Command="{Binding SaveSettingsCommand}" 
                                    Height="30" FontWeight="SemiBold" Background="#007ACC" Foreground="White" BorderThickness="0"/>
                            <Button Grid.Column="2" Content="Gỡ Cài Đặt" Command="{Binding UninstallExtensionCommand}" 
                                    Height="30" Padding="10,0" Foreground="#C62828" BorderBrush="#EF9A9A"
                                    ToolTip="Gỡ bỏ hoàn toàn Lumi SQL Formatter và các extension cũ khỏi SSMS"/>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Right: Live Preview Panel (Syntax Highlighted & Theme-Reactive) -->
                    <GroupBox Grid.Column="1" Padding="8">
                        <GroupBox.Header>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Live Real-time Preview" FontWeight="SemiBold" Foreground="#007ACC"/>
                                <Border DockPanel.Dock="Right" Background="#E8F2FA" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="T-SQL SYNTAX" FontSize="9" FontWeight="Bold" Foreground="#007ACC"/>
                                </Border>
                            </DockPanel>
                        </GroupBox.Header>
                        <Grid>
                            <RichTextBox x:Name="PreviewRichTextBox" 
                                         IsReadOnly="True" 
                                         IsDocumentEnabled="True"
                                         FontFamily="Consolas, 'Cascadia Code', Courier New" 
                                         FontSize="12.5" 
                                         Background="{Binding PreviewBackground}" 
                                         Foreground="{Binding PreviewForeground}"
                                         BorderBrush="{Binding PreviewBorderBrush}"
                                         BorderThickness="1"
                                         Padding="8"
                                         VerticalScrollBarVisibility="Auto" 
                                         HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: SNIPPET MANAGER -->
            <TabItem Header="Snippet Manager">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="190" MinHeight="108"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*" MinHeight="180"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Custom Snippets Directory Section -->
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="8,6" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Thư mục Snippets:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SnippetsDirectoryPath, Mode=OneWay}" IsReadOnly="True" 
                                     Height="26" VerticalContentAlignment="Center" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="6,2"/>
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseSnippetsFolderCommand}" Padding="8,4" Margin="6,0,0,0"/>
                            <Button Grid.Column="3" Content="Mở thư mục" Command="{Binding OpenSnippetsFolderCommand}" Padding="8,4" Margin="4,0,0,0"/>
                            <Button Grid.Column="4" Content="Làm mới" Command="{Binding ReloadSnippetsCommand}" Padding="8,4" Margin="4,0,0,0" ToolTip="Tải lại toàn bộ snippet từ thư mục đã trỏ"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Actions Toolbar -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Thêm mới" Command="{Binding AddNewSnippetCommand}" Background="#007ACC" Foreground="White" FontWeight="SemiBold" Padding="10,4" Margin="0,0,6,0" BorderThickness="0"/>
                            <Button Content="Xóa" Command="{Binding DeleteSnippetCommand}" Foreground="#C62828" BorderBrush="#EF9A9A" Padding="10,4" Margin="0,0,12,0"/>
                            <Button Content="Import JSON" Command="{Binding ImportSnippetsCommand}" Padding="8,4" Margin="0,0,6,0"/>
                            <Button Content="Export JSON" Command="{Binding ExportSnippetsCommand}" Padding="8,4"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Mẹo: Nhấn Ctrl+Alt+S để tạo nhanh từ vùng chọn" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" FontSize="11"
                                   ToolTip="Nhấn Ctrl+Alt+S trong Query Editor để tạo nhanh snippet từ vùng chọn"/>
                    </Grid>

                    <!-- Row 2: Snippets DataGrid (Height optimized for displaying multiple snippets) -->
                    <DataGrid x:Name="SnippetsGrid"
                              Grid.Row="2" 
                              ItemsSource="{Binding Snippets}" 
                              SelectedItem="{Binding SelectedSnippet, Mode=TwoWay}"
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False"
                              CanUserSortColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              RowHeight="26"
                              ColumnHeaderHeight="28"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Prefix (Phím tắt)" Binding="{Binding Prefix}" Width="150" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Mô tả chức năng" Binding="{Binding Description}" Width="260"/>
                            <DataGridTextColumn Header="Nội dung Body (Template)" Binding="{Binding Body}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 3: Resizable GridSplitter -->
                    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                  Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" 
                                  Cursor="SizeNS"/>

                    <!-- Row 4: Snippet Detail Editor (Expands to fill vertical space) -->
                    <GroupBox Grid.Row="4" Padding="10">
                        <GroupBox.Header>
                            <TextBlock Text="Trình Soạn Thảo Snippet Chi Tiết" FontWeight="SemiBold" Foreground="#007ACC"/>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Prefix: " VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,6,0"/>
                                <TextBox x:Name="PrefixTextBox" Grid.Column="1" 
                                         Text="{Binding EditingPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="26" VerticalContentAlignment="Center" FontWeight="Bold"
                                         PreviewMouseLeftButtonDown="OnTextBoxPreviewMouseLeftButtonDown"
                                         GotKeyboardFocus="OnTextBoxGotKeyboardFocus"/>

                                <TextBlock Grid.Column="2" Text="Mô tả: " VerticalAlignment="Center" FontWeight="Medium" Margin="14,0,6,0"/>
                                <TextBox x:Name="DescriptionTextBox" Grid.Column="3" 
                                         Text="{Binding EditingDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="26" VerticalContentAlignment="Center"
                                         PreviewMouseLeftButtonDown="OnTextBoxPreviewMouseLeftButtonDown"
                                         GotKeyboardFocus="OnTextBoxGotKeyboardFocus"/>
                            </Grid>

                            <TextBox x:Name="TemplateTextBox" Grid.Row="1" 
                                     Text="{Binding EditingTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     FontFamily="Consolas, Courier New" FontSize="12"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="{Binding SnippetEditorBackground}" Foreground="{Binding SnippetEditorForeground}"
                                     Padding="6" Margin="0,0,0,6"
                                     PreviewMouseLeftButtonDown="OnTextBoxPreviewMouseLeftButtonDown"
                                     GotKeyboardFocus="OnTextBoxGotKeyboardFocus"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Chèn $CURSOR$" Click="InsertCursor_Click" Focusable="False" 
                                        Background="#0E639C" Foreground="White" FontWeight="SemiBold" Padding="10,4" Margin="0,0,10,0" BorderThickness="0"/>
                                <Button Content="Lưu Snippet" Command="{Binding SaveCurrentSnippetCommand}" 
                                        Background="#107C41" Foreground="White" FontWeight="Bold" Padding="18,4" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Margin="0,6,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#107C41" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#107C41" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
